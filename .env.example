# Copy to .env and adjust. Never commit .env.
PIXELMIND_ARTIFACTS_DIR=./artifacts
PIXELMIND_MAX_UPLOAD_MB=25
PIXELMIND_MAX_PIXELS=4194304
PIXELMIND_MIN_REGION_PX=16
# RAG (Sprint 5). Claude credentials: ANTHROPIC_API_KEY, or `ant auth login`.
# ANTHROPIC_API_KEY=
PIXELMIND_LLM_PROVIDER=claude          # claude | extractive (no LLM)
PIXELMIND_LLM_MODEL=claude-opus-5-5    # e.g. claude-haiku-5-5 for lower cost
PIXELMIND_LLM_EFFORT=medium
PIXELMIND_RAG_MODE=hybrid              # dense | sparse | hybrid
PIXELMIND_RAG_MIN_SCORE=0.40
